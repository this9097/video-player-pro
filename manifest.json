{
  "name": "Video Player Pro",
  "short_name": "VPlayer Pro",
  "description": "재생 + 자르기 통합 비디오 플레이어 (재인코딩 없음) · 심상현",
  "id": "/index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0b0e",
  "theme_color": "#0b0b0e",
  "orientation": "any",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "video/mp4": [".mp4", ".m4v"],
        "video/quicktime": [".mov"],
        "video/x-matroska": [".mkv"],
        "video/x-msvideo": [".avi"],
        "video/webm": [".webm"],
        "video/x-ms-wmv": [".wmv"],
        "video/x-flv": [".flv"],
        "video/mp2t": [".ts", ".m2ts", ".mts"],
        "application/x-subrip": [".srt"],
        "text/vtt": [".vtt"]
      },
      "launch_type": "single-client"
    }
  ]
}
